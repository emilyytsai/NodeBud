# Google AI Studio — Gemma 4 via the Gemini API. Required for Phase 1.
# Generate at https://aistudio.google.com (then Get API Key).
GOOGLE_AI_KEY=your_key_here
# Pick the latest Gemma model from the AI Studio model picker.
GEMMA_MODEL_NAME=gemma-2-9b-it

# ElevenLabs TTS. Required for Phase 3 demo voice.
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ENCOURAGING=
ELEVENLABS_VOICE_STRICT=
ELEVENLABS_VOICE_PEER=

# Backboard (optional Phase 4.5 add-on; promo code BRONCOHACKSMLH).
BACKBOARD_API_KEY=

# Exposed to the browser. Used as the user_id for memory recall in dev/demo.
NEXT_PUBLIC_DEMO_USER_ID=demo-user-1
